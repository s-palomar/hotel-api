#######################################
### HABITACIONES
#######################################

### Crear hotel en Madrid
POST http://localhost:8080/api/hoteles
Content-Type: application/json

{
  "nombre": "Hotel Palace",
  "ciudad": "Madrid",
  "categoria": 5
}

###

### Crear hotel en Vigo
POST http://localhost:8080/api/hoteles
Content-Type: application/json

{
  "nombre": "Hotel Atlántico",
  "ciudad": "Vigo",
  "categoria": 4
}

###

### Crear habitación individual
POST http://localhost:8080/api/habitaciones/hotel/1
Content-Type: application/json

{
    "numero": "101",
    "precioBase": 75.0,
    "tipoHabitacion": "INDIVIDUAL"
}

### Crear habitación doble
POST http://localhost:8080/api/habitaciones/hotel/1
Content-Type: application/json

{
    "numero": "102",
    "precioBase": 110.0,
    "tipoHabitacion": "DOBLE"
}

### Crear suite
POST http://localhost:8080/api/habitaciones/hotel/1
Content-Type: application/json

{
    "numero": "201",
    "precioBase": 220.0,
    "tipoHabitacion": "SUITE"
}

### Crear habitación doble en otro hotel
POST http://localhost:8080/api/habitaciones/hotel/2
Content-Type: application/json

{
    "numero": "301",
    "precioBase": 120.0,
    "tipoHabitacion": "DOBLE"
}

