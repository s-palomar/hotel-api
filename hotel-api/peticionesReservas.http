Content-Type: application/json

{
  "dni": "11111111C",
  "nombre": "Juan",
  "apellidos": "Pérez García",
  "email": "juan.perez@email.com",
  "telefono": "600111222",
  "nacionalidad": "España",
  "formaPago": "TARJETA"
}

